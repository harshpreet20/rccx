{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/email/daily-digest",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/email/weekly-roundup",
      "schedule": "0 3 * * 1"
    }
  ]
}
